{
  "name": "vmp-monitor",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "VMP Monitor — Theo dõi Kế hoạch Thẩm định Gốc (CPC1 HN). React + Vite trên Supabase: Supabase là nơi lưu dữ liệu gốc, nhập liệu ngay trên dashboard qua RPC có kiểm quyền.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.mjs",
    "test:db:five-role": "bash scripts/run-five-role-db-tests.sh",
    "test:db:source-access": "bash scripts/run-source-qa-workshop-access-db-tests.sh",
    "test:permissions": "npm run test:unit && node tests/e2e/danh-ba-phan-quyen.mjs && node tests/e2e/quyen-cot-timeline.mjs && node tests/e2e/thu-hoi-cache-phan-quyen.mjs && node tests/e2e/danh-muc-nguoi-thuc-hien.mjs",
    "gen:permission-workbook": "node scripts/permission-workbook.mjs public/templates/phan-quyen-vmp.xlsx",
    "gen:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/types/database.ts",
    "e2e": "node tests/e2e/luong-chinh.mjs && node tests/e2e/quet-tat-ca-man.mjs && node tests/e2e/giam-chuyen-dong.mjs && node tests/e2e/phien-het-han.mjs && node tests/e2e/tai-lai-nhieu-lan.mjs && node tests/e2e/danh-muc-nguoi-thuc-hien.mjs && node tests/e2e/ux-refinement.mjs",
    "cham": "node tests/e2e/cham-giao-dien.mjs",
    "viec": "node tests/e2e/viec-nguoi-dung.mjs",
    "doichieu": "node tests/e2e/doi-chieu-du-lieu.mjs",
    "thammy": "node tests/e2e/tham-my.mjs",
    "e2e:gialap": "node tests/e2e/luong-gia-lap.mjs && node tests/e2e/tai-khoan-an-sap-xep.mjs && node tests/e2e/timeline-deadline-edit.mjs",
    "e2e:catalog": "node tests/e2e/catalog-workspace.mjs",
    "e2e:source-access": "node tests/e2e/source-qa-workshop-access.mjs",
    "e2e:progress-rights": "node tests/e2e/quyen-cot-timeline.mjs && node tests/e2e/phan-cong-cap-nhat-tien-do.mjs",
    "e2e:today-scope": "node tests/e2e/today-personal-scope.mjs",
    "e2e:admin": "node tests/e2e/quyen-admin.mjs && node tests/e2e/access-transition-race.mjs",
    "shell": "node tests/e2e/lotus-shell.mjs",
    "atelier": "node tests/e2e/atelier.mjs",
    "drift": "node scripts/check-design-drift.mjs",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:capnhat": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "visual:runtime": "node --import tsx scripts/check-visual-runtime.mjs --runtime",
    "visual:baseline:seal": "node --import tsx scripts/check-visual-runtime.mjs --write-baseline-contract",
    "visual:contract": "node --import tsx scripts/check-visual-runtime.mjs --verify-baseline",
    "a11y": "playwright test -c playwright.a11y.config.ts",
    "e2e:luongchinh": "node tests/e2e/luong-chinh.mjs",
    "e2e:ux": "node tests/e2e/ux-refinement.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.108.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^25.7.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "uuid": "^11.1.1"
  }
}

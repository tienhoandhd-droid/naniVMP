# =====================================================================
#  .env.example — Mẫu biến môi trường (KHÔNG chứa secret, an toàn commit)
#  Sao chép thành .env cho dev cục bộ, hoặc đặt trong
#  GitHub → Settings → Secrets and variables → Actions → Variables khi deploy.
#  Chỉ biến có tiền tố VITE_ mới lộ ra client.
# =====================================================================

# ---- Supabase: read model cho dashboard ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON=<anon-key-jwt>

# ---- n8n webhook ĐỌC (fallback) ----
# Không cần thiết: dashboard đọc thẳng Supabase RPC. Để trống.
VITE_VMP_READ_URL=

# ---- n8n webhook GHI ngược Sheet ----
# CỐ Ý BỎ TRỐNG: kiến trúc hiện tại khóa ghi nghiệp vụ từ browser.
# Google Sheet là nguồn canonical upstream, Supabase là read model cho dashboard.
# Không đặt biến này ở production nếu chưa có quy trình ghi đã được duyệt.
# VITE_N8N_WRITE_URL=

# ---- n8n webhook cảnh báo/báo cáo AI (tuỳ chọn) ----
VITE_N8N_AI_REPORT_URL=

# --- Trợ lý hỏi đáp VMP (n8n "Vani VMP 4") --------------------------
# Webhook nhận câu hỏi. Bên n8n dùng AI Agent Gemini + 2 công cụ Postgres.
VITE_N8N_CHAT_URL=https://n8n.cpc1hn.com/webhook/vmp-hoi-dap
# Giá trị header x-vmp-secret mà webhook đòi. LỘ RA TRÌNH DUYỆT — chỉ đặt
# token dùng riêng cho webhook này, đừng dùng lại token có quyền khác.
VITE_N8N_CHAT_TOKEN=
